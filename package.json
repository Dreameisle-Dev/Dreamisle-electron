{
  "name": "dreamisle",
  "version": "1.0.0",
  "description": "An offline music player",
  "license": "MIT",
  "author": "Dreamisle-Dev",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "format": "prettier --write src/",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac --config.mac.identity=-"
  },
  "build": {
    "appId": "org.dreamisle-dev.dreamisle",
    "win": {
      "icon": "src/assets/app_icon.ico",
      "appId": "org.dreamisle-dev.dreamisle",
      "asarUnpack": [
        "node_modules/koffi/**/*",
        "node_modules/@koromix/koffi-win32-*/**/*"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "src/assets/icon_512x512@2x.png",
      "hardenedRuntime": true,
      "extendInfo": {
        "CFBundleDisplayName": "Dreamisle"
      },
      "files": [
        "!**/node_modules/koffi{,/**/*}",
        "!**/node_modules/@koromix{,/**/*}"
      ]
    },
    "linux": {
      "files": [
        "!**/node_modules/koffi{,/**/*}",
        "!**/node_modules/@koromix{,/**/*}"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "music-metadata": "^11.16.1"
  },
  "optionalDependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.4.0",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "koffi@3.3.3": true
  }
}
