{
  "name": "dreamisle",
  "version": "1.0.0",
  "description": "An offline music player",
  "license": "MIT",
  "author": "Dreamisle-Dev",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "format": "prettier --write src/",
    "build:win": "electron-builder --win"
  },
  "build": {
    "asarUnpack": ["node_modules/koffi/**/*"],
    "win": {
      "icon": "src/assets/app_icon.ico",
      "appId": "org.dreamisle-dev.dreamisle"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "koffi": "^3.3.3",
    "music-metadata": "^11.10.6"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "prettier": "^3.9.6"
  }
}
